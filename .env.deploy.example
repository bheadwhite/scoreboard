# Production values. Copy to .env.deploy — gitignored — and run scripts/deploy.sh,
# which syncs each key into Google Secret Manager and binds it to the service.

# ── Google Cloud ──────────────────────────────────────────────────────────────
GCP_PROJECT=your-project-id
GCP_REGION=us-central1
SERVICE=scoreboard

# ── Database ──────────────────────────────────────────────────────────────────
# MUST be the Supabase transaction pooler on port 6543, not the direct 5432
# connection. Cloud Run creates many short-lived instances and would otherwise
# exhaust the connection ceiling. The server disables prepared statements to
# match; see backend/internal/store/store.go.
#
# Dashboard → Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# This app runs the Google OAuth flow itself and issues its own signed session
# cookies. Supabase is only a Postgres host.
#
# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
# Add "<APP_URL>/auth/google/callback" to that client's authorized redirect URIs.
# GCP_OAUTH_CLIENT / GCP_OAUTH_SECRET are accepted as aliases.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs session and OAuth-state cookies. Generate with: openssl rand -hex 32
# Changing it logs every player out.
SESSION_SECRET=

# The public origin the app is served from. The OAuth redirect URI is derived
# from it, so it must match the deployed URL exactly or every sign-in fails with
# redirect_uri_mismatch. Only known after the first deploy — the deploy script
# warns if it drifts.
APP_URL=https://<service>-<hash>-uc.a.run.app

# ── Behavior ──────────────────────────────────────────────────────────────────
CONCEDE_WINDOW=168h

# Bearer token for POST /tasks/sweep. Cloud Scheduler sends this every 15
# minutes, which finalizes expired claims and keeps the free-tier Supabase
# project from being paused for inactivity.
SWEEP_TOKEN=
