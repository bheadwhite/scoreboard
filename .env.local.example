# Local development. Copy to .env.local — that file is gitignored.
#
# The backend reads .env and .env.local on boot; the Makefile also sources
# .env.local so `make sweep` and friends pick up the same values. Anything
# already set in your shell wins.

# ── Database ──────────────────────────────────────────────────────────────────
# Locally this is plain Postgres. In production it is the Supabase *transaction
# pooler* URI (port 6543, not 5432) — see DEPLOY.md for why that matters.
DATABASE_URL=postgres://you@localhost:5432/scoreboard_dev?sslmode=disable

# ── Auth ──────────────────────────────────────────────────────────────────────
# Signs session and OAuth-state cookies. Any random string works locally.
SESSION_SECRET=dev-secret-change-me

# The origin the browser is on. In development that is Vite, which proxies
# /auth and /api to this server so the OAuth round trip lands back correctly.
APP_URL=http://localhost:3000

# Sign in as anybody without Google, at /auth/dev/login?name=Bill. The server
# refuses to enable this alongside production.
AUTH_DEV_LOGIN=true

# Real Google sign-in locally. Add http://localhost:3000/auth/google/callback to
# the client's authorized redirect URIs first.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ── The concession clock ──────────────────────────────────────────────────────
# How long a claimed win waits for the losers before the concession is assumed.
# Any Go duration ("30m", "168h"). Short values are handy for testing the sweeper.
# This is a backstop for a match everyone stopped caring about, not a deadline
# anybody should be hitting — keep it generous.
CONCEDE_WINDOW=168h

# Shared secret for POST /tasks/sweep, which finalizes timed-out claims and
# doubles as the database keepalive. Without it the endpoint 404s.
SWEEP_TOKEN=pick-something-random

PORT=8080
